# Copy to tools/mp3quran-ingest/.env (gitignored) and fill in locally.
# Names only in the repo. Never commit the filled-in file.
# Real environment variables take precedence over this file.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quran
R2_PUBLIC_BASE=https://audio.taybah-app.com

# Worker mode (--via worker, the default with --upload): see ../r2-copy-worker/README.md
R2_COPY_WORKER_URL=
R2_COPY_TOKEN=
