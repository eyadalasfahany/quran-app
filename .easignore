.agents/
.claude/
.cursor/
.qodo/
.rtk/
/.expo/
AGENTS.md
CLAUDE.md
.mcp.json
skills-lock.json

# OS and editors
.DS_Store
.idea/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision

