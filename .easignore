# EAS uploads the whole repo for builds. When this file exists EAS ignores .gitignore,
# so it repeats the secret and generated-file rules from .gitignore.

# Not part of the app build
apps/api/
infra/
docs/
.github/
website/
design-assets/
graphify-out/
image/
/IBM-Plex-Sans-Arabic/
# Local OpenDua audio working copy (ADR 0040); served by the API, never bundled
/opendua-audio-*/
apps/mobile/__tests__/
apps/mobile/jest/

# Design files and root scratch (the app reads none of them)
/*.html
/*.png
/dump.rdb
/scratch-*.js

