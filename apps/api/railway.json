{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["/usr/local/bin/entrypoint.sh", "/usr/local/bin/release.sh"],
    "startCommand": "/usr/local/bin/entrypoint.sh frankenphp run --config /etc/caddy/Caddyfile",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
