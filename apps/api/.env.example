APP_NAME=Quran
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Homebrew MySQL on this Mac (ADR 0004). Local-only credentials; see docs/runbooks/local-setup.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quran
DB_USERNAME=quran
DB_PASSWORD=quran

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Homebrew Redis on this Mac (ADR 0004). predis needs no PHP extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No Mailpit yet (ADR 0004): mail is written to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PULSE_ENABLED=true

# Quran Foundation API (content-plan "Environments"). Prelive keys for local and staging, production keys only in production.
# Real values go in .env only; never commit them. The secret is shown once in the QF Developer Console.
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Contact address in the User-Agent of every QF request (spec §3).
QF_CONTACT_EMAIL=

# Dorar hadith reference API (ADR 0031 §2). Off by default. Leave the token empty here; real values go in .env only.
# Dorar is used only through this API, never from the app. No Dorar data is stored in content packs.
DORAR_ENABLED=false
DORAR_API_BASE_URL=
DORAR_API_TOKEN=
DORAR_TOKEN_HEADER=Authorization
DORAR_TOKEN_PREFIX="Bearer "
DORAR_TIMEOUT_SECONDS=5
DORAR_MAX_REQUESTS_PER_MINUTE=30
DORAR_CACHE_TTL_SECONDS=0

# OpenDua Azkar import (ADR 0031 §1). Keep false until OpenDua confirms the rights in writing.
AZKAR_OPENDUA_IMPORT_ENABLED=false
