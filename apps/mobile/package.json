{
  "name": "@quran/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:generate:user": "drizzle-kit generate --config drizzle.user.config.ts",
    "seed:build": "node scripts/build-content-seed.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "postinstall": "node scripts/patch-nitro-exception-ptr.mjs && node scripts/patch-expo-audio-exact-seek.mjs && node scripts/patch-expo-dev-launcher-widget-host.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@native-html/render": "1.0.4",
    "@quran/api-contract": "*",
    "@quran/design-tokens": "*",
    "@quran/quran-text-check": "*",
    "@react-native-community/datetimepicker": "9.2.1",
    "@shopify/flash-list": "2.3.2",
    "adhan": "4.4.6",
    "app-group-store": "file:./modules/app-group-store",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "fflate": "0.8.3",
    "i18next": "26.5.11",
    "react": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-android-widget": "0.26.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-watch-connectivity": "2.0.0",
    "react-native-worklets": "0.13.0",
    "suncalc": "2.1.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "astronomy-engine": "^2.1.19",
    "babel-plugin-inline-import": "3.0.0",
    "babel-preset-expo": "~58.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "resolver": "react-native-reanimated/jest/resolver",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^app-group-store$": "<rootDir>/modules/app-group-store/src/index.ts"
    },
    "testTimeout": 30000,
    "maxWorkers": 3,
    "workerIdleMemoryLimit": "768MB"
  }
}
