    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:generate:user": "drizzle-kit generate --config drizzle.user.config.ts",
    "seed:build": "node scripts/build-content-seed.mjs",
    "postinstall": "node scripts/patch-nitro-exception-ptr.mjs"
  },
  "dependencies": {
    "@native-html/render": "1.0.4",
