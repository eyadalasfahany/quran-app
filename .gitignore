# OS and editors
.DS_Store
Thumbs.db
.idea/
*.swp

# Local AI and agent tooling (project skills in .claude/skills stay tracked)
.claude/settings.local.json
.qodo/
graphify-out/

# Secrets: env files and signing keys never enter git
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Node workspaces
node_modules/
npm-debug.log*
*.tsbuildinfo
coverage/
dist/

# Expo app (continuous native generation: ios/ and android/ are generated)
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts

# Laravel API (apps/api keeps its own .gitignore for storage, cache and logs)
apps/api/vendor/
apps/api/.phpunit.result.cache
apps/api/.phpunit.cache/

# Docker volumes kept on disk
infra/data/

# OpenDua recordings: contracted recitation, not licensed to us (ADR 0031 §8, ADR 0038 §3). Never commit.
/opendua-audio-hisn-v0.0.2/

# Local recitation audio (rights-restricted, never committed)
/*.mp3
/*.wav
tools/recitation-align/.venv/
tools/recitation-align/out/

# MP3Quran ingest (ADR 0061): local .env stays out via `.env`; downloads and dry-run output stay out
tools/mp3quran-ingest/.venv/
tools/mp3quran-ingest/out/
__pycache__/
.pytest_cache/

# R2 copy Worker (ADR 0061, plan B4): local Wrangler state; node_modules is covered by the Node workspaces rule
tools/r2-copy-worker/.wrangler/
